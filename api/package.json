{
  "name": "gamecore-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import typescript --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "migrate:up": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/postgres": "^6.1.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  },
  "description": "",
  "main": "index.js",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "thread-stream": "^4.2.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
