<!DOCTYPE html>
    <html>
    <head>
    <meta charset="UTF-8">
    <style>
        @page {{
            size: {WIDTH}px {HEIGHT}px;
            margin: 0;
        }}

        * {{
            box-sizing: border-box;
        }}

        html, body {{
            width: {WIDTH}px;
            height: {HEIGHT}px;
            margin: 0;
        }}

        body {{
            background: #ffffff;
            color: #000000;
            font-family: "DejaVu Sans", sans-serif;
        }}

        .page {{
            width: 100%;
            height: 100%;
            padding: 24px 28px 16px;
            display: flex;
            flex-direction: column;
        }}

        .header {{
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #c9c9bc;
            padding-bottom: 14px;
        }}

        .eyebrow {{
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1px;
            color: #ff0c0c;
        }}

        h1 {{
            font-size: 30px;
            margin: 5px 0 0;
            line-height: 1.1;
        }}

        .timestamp {{
            font-size: 11px;
            color: #60645c;
            text-align: right;
        }}

        .error-card {{
            background: #fff;
            border: 2px solid #ff161a;
            border-radius: 9px;
            margin-top: 16px;
            padding: 12px 16px;
        }}

        .error-type {{
            font-size: 13px;
            font-weight: bold;
            color: #ff1e40;
            margin-bottom: 5px;
        }}

        .error-message {{
            font-size: 16px;
            font-weight: bold;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }}

        .trace-card {{
            flex: 1;
            min-height: 0;
            background: #fff;
            border: 1px solid #d7d7ca;
            border-radius: 9px;
            margin-top: 12px;
            padding: 12px 15px;
            overflow: hidden;
            font-family: consolas;
        }}

        .trace-label {{
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1px;
            color: #000000;
            margin-bottom: 9px;
        }}

        pre {{
            margin: 0;
            font-family: "DejaVu Sans Mono", monospace;
            font-size: 14px;
            line-height: 1.4;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            color: #000000;
        }}

        .footer {{
            display: flex;
            justify-content: space-between;
            padding-top: 10px;
            font-size: 10px;
            color: #77796e;
        }}
    </style>
    </head>
    <body>
        <div class="page">

            <div class="header">
                <div>
                    <div class="eyebrow">SYSTEM STATUS · ERROR</div>
                    <h1>Something went wrong.</h1>
                </div>
                <div class="timestamp">{TIMESTAMP}</div>
            </div>

            <div class="error-card">
                <div class="error-type">{ERROR_TYPE}</div>
                <div class="error-message">{ERROR_MESSAGE}</div>
            </div>

            <div class="trace-card">
                <div class="trace-label">PYTHON TRACEBACK</div>
                <pre>{STACK_TRACE}</pre>
            </div>

            <div class="footer">
                <span>INKY HOME · DIAGNOSTICS</span>
                <span>Dashboard rendering failed</span>
            </div>

        </div>
    </body>
    </html>